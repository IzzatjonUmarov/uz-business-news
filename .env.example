# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC...
# @username канала или его числовой id (-100...). Бота нужно сделать админом канала.
TELEGRAM_CHAT_ID=@my_uz_business_channel

# Необязательно: ключ Claude API для отбора важных новостей и пересказа (console.anthropic.com)
ANTHROPIC_API_KEY=
# Модель для пересказа. Для экономии можно поставить claude-haiku-5-5
AI_MODEL=claude-opus-5-5
AI_ENABLED=true
# Публиковать новости со значимостью не ниже (1–5)
MIN_IMPORTANCE=3

MAX_POSTS_PER_RUN=15
POST_DELAY_SECONDS=4
MAX_AGE_DAYS=3
