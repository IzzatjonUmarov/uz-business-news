# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC...
# @username канала или его числовой id (-100...). Бота нужно сделать админом канала.
TELEGRAM_CHAT_ID=@my_uz_business_channel

# Необязательно: ключ Claude API для отбора важных новостей и пересказа (console.anthropic.com)
ANTHROPIC_API_KEY=
# Модель для пересказа. Для экономии можно поставить claude-haiku-5-5
AI_MODEL=claude-opus-5-5
AI_ENABLED=true
# Публиковать новости со значимостью не ниже (1–5)
MIN_IMPORTANCE=3

# Интервал между постами в канале (минуты); новости ждут своей очереди
POST_INTERVAL_MINUTES=30
MAX_QUEUE=100
MAX_AGE_DAYS=3

# ── Узбекская версия ──
# Второй язык в каждом посте: узбекский на латинице в новой редакции алфавита (ЗРУ-1184: ş, ç, ö, ğ)
UZBEK_ENABLED=true

# ── Картинки к постам ──
IMAGES_ENABLED=true
# Надпись водяного знака. Если пусто — берётся @username канала из TELEGRAM_CHAT_ID
WATERMARK_TEXT=
# Логотип канала: PNG с прозрачным фоном, например assets/logo.png (необязательно)
WATERMARK_LOGO=
# Непрозрачность плашки в углу (0–1)
WATERMARK_OPACITY=0.85
# Бледный диагональный повтор надписи по всей картинке (защита от обрезки)
WATERMARK_TILED=true
